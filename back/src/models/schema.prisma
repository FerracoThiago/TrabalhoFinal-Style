
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id            Int @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String  @unique
  phone         String?
  birthday      DateTime?
  gender        gender?
  hash          String  
  salt          String
  notifications Int
  profPicPath   String?
  //tags        Tags[]
  address     Address[]
}

model Address{
  id        Int    @id @default(autoincrement())
  street    String
  city      String
  state     String
  zipCode   String
  type      String
  user      User[]
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  price         Float
  discount      Float?
  avgReview     Float?
  specification String
  tags          String[] //para que existam varias tags
  category      String
  inStock       Boolean

  //variantes  Variante[]
  //cartItems  Cart[]
  //wishlists  Wishlist[]
  //orderItems OrderItem[]
  //reviews    Review[]
}



