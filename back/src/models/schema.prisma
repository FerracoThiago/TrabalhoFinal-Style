
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id            Int @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String  @unique
  phone         String?
  birthday      DateTime?
  gender        gender?
  hash          String  
  salt          String
  notifications Int
  profPicPath   String?

  tags          Tags[]
  address       Address[]
  coupons       Cupom[]
  orders        Order[]
  wishlist      Wishlist[]
  cart          Cart[]
  reviews       Review[]
}

model Tags{
  id        Int    @id @default(autoincrement())
  content   String
  user      User[]
}


model Address{
  id        Int    @id @default(autoincrement())
  street    String
  city      String
  state     String
  zipCode   String
  type      String
  user      User[]
}

model Cupom{
  id            Int @id @default(autoincrement())
  usageLimit    Int
  validate      DateTime
  discountMax   Float
  code          String
  discount      Float

  users         User[]
  order         Order[]
}

model Cart{
  id          Int @id @default(autoincrement())
  total       Float
  subtotal    Float
  savings     Float
  shipping    Float
  promoCode   String?

  userId      Int  @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items       Product[]       //implicit n:n
}

model Wishlist{
  id       Int @id @default(autoincrement())

  userId   Int  @unique
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items    Product[]       //implicit n:n

}

model Review{
  id        Int      @id @default(autoincrement())
  rating    Int

  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)   //faz sentido se o usuário for deletado, o review continua existindo

  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

}

model Order {
  id            Int      @id @default(autoincrement())
  time          DateTime @default(now())
  status        String
  total         Float
  paymentMethod String

  userId        Int
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  cupomId       Int?
  cupom         Cupom? @relation(fields: [cupomId], references: [id], onDelete: SetNull)

  items         OrderItem[]
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  price         Float
  discount      Float?
  avgReview     Float?
  specification String
  tags          String[] 
  category      String
  inStock       Boolean

  //variants    Variante[]
  cartItems     Cart[]         //implicit n:n
  wishlists     Wishlist[]     //implicit n:n
  orderItems    OrderItem[]
  reviews       Review[]
}


model OrderItem {
  id          Int @id @default(autoincrement())
  quantity    Int

  orderId     Int
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}


