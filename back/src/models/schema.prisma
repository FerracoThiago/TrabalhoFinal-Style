
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id            Int @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String  @unique
  phone         String?
  birthday      DateTime?
  gender        gender?
  hash          String  
  salt          String
  notifications Int
  profPicPath   String?
  //tags        Tags[]
  address       Address[]
  orders         Order[]
}

model Address{
  id        Int    @id @default(autoincrement())
  street    String
  city      String
  state     String
  zipCode   String
  type      String
  user      User[]
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  price         Float
  discount      Float?
  avgReview     Float?
  specification String
  tags          String[] 
  category      String
  inStock       Boolean

  //variantes  Variante[]
  //cartItems  Cart[]
  //wishlists  Wishlist[]
  orderItems OrderItem[]
  //reviews    Review[]
}

model Order {
  id            Int      @id @default(autoincrement())
  time          DateTime @default(now())
  status        String
  total         Float
  paymentMethod String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  cupomId Int?
  //cupom Cupom @relation(fields: [cupomId], references: [id])

  items OrderItem[]
}

model OrderItem {
  id       Int @id @default(autoincrement())
  quantity Int

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}


